+  mu[kColorRefPrimary30] = {kColorRefNeutral30};
+  mu[kColorRefPrimary40] = {kColorRefNeutral40};
+  mu[kColorRefPrimary50] = {kColorRefNeutral50};
+  mu[kColorRefPrimary60] = {kColorRefNeutral60};
+  mu[kColorRefPrimary70] = {kColorRefNeutral70};
+  mu[kColorRefPrimary80] = {kColorRefNeutral80};
+  mu[kColorRefPrimary90] = {kColorRefNeutral90};
+  mu[kColorRefPrimary95] = {kColorRefNeutral95};
+  mu[kColorRefPrimary99] = {kColorRefNeutral99};
+  mu[kColorRefPrimary100] = {kColorRefNeutral100};
 }
 
