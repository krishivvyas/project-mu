Project Mu: load Mu's bundled theme and New Tab page on every start

Mu's look ships next to chrome.exe as two unpacked extensions:
mu\theme (the Sumi theme: sumi frame, kiri toolbar, washi text) and
mu\newtab (a New Tab page that is only negative space and 無).

Upstream only loads unpacked extensions given with --load-extension, which
works from Mu's own shortcuts but not when Windows or another app starts
chrome.exe directly. Load the two folders on every start instead, through the
same code path as --load-extension (so they obey the same restrictions).
Windows only, where the installer and portable zip ship the folders.

Mu's New Tab page is also marked as acknowledged, so Chromium does not ask
"Did you mean to change this page?" about it.

diff --git a/chrome/browser/extensions/extension_service.cc b/chrome/browser/extensions/extension_service.cc
index bbfff3d..f0c8075 100644
--- a/chrome/browser/extensions/extension_service.cc
+++ b/chrome/browser/extensions/extension_service.cc
@@ -14,6 +14,7 @@
 #include <utility>
 
 #include "base/auto_reset.h"
+#include "base/base_paths.h"
 #include "base/check_op.h"
 #include "base/command_line.h"
 #include "base/debug/alias.h"
@@ -24,6 +25,7 @@
 #include "base/metrics/histogram_functions.h"
 #include "base/observer_list.h"
 #include "base/one_shot_event.h"
+#include "base/path_service.h"
 #include "base/stl_util.h"
 #include "base/strings/string_number_conversions.h"
 #include "base/strings/string_tokenizer.h"
@@ -374,6 +376,30 @@ void ExtensionService::Init() {
   if (load_command_line_extensions) {
     LoadExtensionsFromCommandLineFlag(switches::kLoadExtension);
   }
+#if BUILDFLAG(IS_WIN)
+  // Project Mu: Mu's look ships next to chrome.exe as two unpacked
+  // extensions, mu/theme (the Sumi theme) and mu/newtab (the New Tab page).
+  // Load them on every start, the same way --load-extension would, so Mu looks
+  // like Mu however it is launched.
+  if (load_command_line_extensions) {
+    base::FilePath exe_dir;
+    if (base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+      for (const char* name : {"theme", "newtab"}) {
+        std::string extension_id;
+        UnpackedInstaller::Create(profile_)->LoadFromCommandLine(
+            exe_dir.AppendASCII("mu").AppendASCII(name), &extension_id,
+            /*only_allow_apps=*/false);
+        // Mu's own New Tab page is not a surprise: skip Chromium's "Did you
+        // mean to change this page?" prompt for it
+        // (kNtpOverridingExtensionAcknowledged).
+        if (!extension_id.empty() && std::string_view(name) == "newtab") {
+          extension_prefs_->UpdateExtensionPref(extension_id, "ack_ntp_bubble",
+                                                base::Value(true));
+        }
+      }
+    }
+  }
+#endif  // BUILDFLAG(IS_WIN)
   EnabledReloadableExtensions();
   delayed_install_manager_->FinishInstallationsDelayedByShutdown();
   SetReadyAndNotifyListeners();
