diff --git a/chrome/browser/ui/color/chrome_color_mixers.cc b/chrome/browser/ui/color/chrome_color_mixers.cc
index 8432f49..a737129 100644
--- a/chrome/browser/ui/color/chrome_color_mixers.cc
+++ b/chrome/browser/ui/color/chrome_color_mixers.cc
@@ -23,6 +23,10 @@
 #include "chrome/browser/ui/color/omnibox_color_mixer.h"
 #include "chrome/browser/ui/color/product_specifications_color_mixer.h"
 #include "chrome/browser/ui/color/tab_strip_color_mixer.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/color/color_recipe.h"
 #include "ui/color/color_provider_utils.h"
 
 namespace {
@@ -73,6 +77,26 @@ void AddChromeColorMixers(ui::ColorProvider* provider,
       chrome_color_provider_utils_callbacks;
   ui::SetColorProviderUtilsCallbacks(
       chrome_color_provider_utils_callbacks.get());
+
+  // Project Mu: Kage, Mu's private window. Themes do not apply there, so it
+  // would get Chromium's grey palette; give it Mu's ink instead: a sumi frame
+  // and a near-black toolbar, a step darker than a normal Mu window. Set at
+  // the system-colour level, before the browser mixers, so everything derived
+  // from them follows. In Mu only private windows are dark, greyscale and
+  // unthemed (normal windows always carry Mu's theme).
+  if (!key.custom_theme && !key.app_controller &&
+      key.color_mode == ui::ColorProviderKey::ColorMode::kDark &&
+      key.user_color_source ==
+          ui::ColorProviderKey::UserColorSource::kGrayscale) {
+    ui::ColorMixer& kage = provider->AddMixer();
+    kage[ui::kColorSysHeader] = {SkColorSetRGB(9, 10, 12)};
+    kage[ui::kColorSysHeaderInactive] = {SkColorSetRGB(9, 10, 12)};
+    kage[ui::kColorSysBase] = {SkColorSetRGB(17, 18, 21)};
+    kage[ui::kColorSysBaseContainer] = {SkColorSetRGB(26, 28, 32)};
+    kage[ui::kColorSysBaseContainerElevated] = {SkColorSetRGB(30, 32, 36)};
+    kage[ui::kColorSysOmniboxContainer] = {SkColorSetRGB(26, 28, 32)};
+  }
+
   AddChromeColorMixer(provider, key);
   AddNewTabPageColorMixer(provider, key);
   AddOmniboxColorMixer(provider, key);
