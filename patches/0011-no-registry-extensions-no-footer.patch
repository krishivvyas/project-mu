index 7b33ea502d..aa4dd50fbc 100644
--- a/chrome/browser/ui/views/new_tab_footer/footer_controller.cc
+++ b/chrome/browser/ui/views/new_tab_footer/footer_controller.cc
@@ -218,7 +218,10 @@ bool NewTabFooterController::ContentsViewFooterCotroller::
     return false;
   }
 
-  return ntp_footer::IsExtensionNtp(url, owner_->profile_) &&
+  // Project Mu: Mu's New Tab page is an extension, and the footer bar it
