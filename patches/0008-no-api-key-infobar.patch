Project Mu: drop the "Google API keys are missing" infobar

Mu ships without Google API keys on purpose (args.gn), so this bar would
greet every launch with a warning about something intended.

diff --git a/chrome/browser/ui/startup/infobar_utils.cc b/chrome/browser/ui/startup/infobar_utils.cc
index 94d977b..80382ea 100644
--- a/chrome/browser/ui/startup/infobar_utils.cc
+++ b/chrome/browser/ui/startup/infobar_utils.cc
@@ -253,7 +253,9 @@ void AddInfoBarsIfNecessary(BrowserWindowInterface* browser,
   infobars::ContentInfoBarManager* infobar_manager =
       infobars::ContentInfoBarManager::FromWebContents(web_contents);
 
-  if (!google_apis::HasAPIKeyConfigured()) {
+  // Project Mu: ships without Google API keys on purpose; never show the
+  // "Google API keys are missing" infobar.
+  if (false && !google_apis::HasAPIKeyConfigured()) {
     if (infobars::IsInfoBarMigrated(
             infobars::InfoBarDelegate::GOOGLE_API_KEYS_INFOBAR_DELEGATE)) {
