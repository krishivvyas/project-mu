{
  "key": "",
  "manifest_version": 3,
  "name": "Mu New Tab",
  "version": "1.1",
  "description": "Project Mu's New Tab page: negative space, nothing to load.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/mu-16.png",
    "32": "icons/mu-32.png",
    "48": "icons/mu-48.png",
    "128": "icons/mu-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "browsingData"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
