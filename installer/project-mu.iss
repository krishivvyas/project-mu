; Project Mu (無) — Windows installer (Inno Setup 6 or 7).
;
; Built by `scripts/build.py package --installer-output ...`, which passes:
;   /DMuVersion=158.0.8127.37      Chromium version being packaged
;   /DMuFiles=C:\...\files.iss     generated [Files] entries for the browser
;   /DMuLicense=C:\...\LICENSE     Project Mu's own license
;   /O<dir> /F<name>               output folder and file name
;
; Replaces Chromium's mini_installer, which has no UI at all (it installs
; silently, so it looks as if nothing happened), installs as "Chromium" and
; shares that product's folders.
;
; Installs per user (no admin) to %LOCALAPPDATA%\Programs\Project Mu by
; default; "Install for all users" in the first dialog installs to Program
; Files instead. The browser keeps its profile in
; %LOCALAPPDATA%\Project Mu\User Data (patch 0006).

#ifndef MuVersion
  #error Pass /DMuVersion=<chromium version>
#endif
#ifndef MuFiles
  #error Pass /DMuFiles=<generated files list>
#endif

#define MuName "Project Mu"
#define MuExe "chrome.exe"
#define MuProgId "ProjectMuHTML"
#define MuClientKey "Software\Clients\StartMenuInternet\Project Mu"
; Chromium's AppUserModelID (base_app_id in chromium_install_modes.h). The
; shortcuts carry the same ID so a pinned shortcut and the open window share
; one taskbar button.
#define MuAumid "Chromium"
; Mu's look (Sumi theme + New Tab page) lives in {app}\mu. Builds with patch
; 0007 load it on every start; passing it here also covers older builds.
#define MuLook '--load-extension=""{app}\mu\theme,{app}\mu\newtab""'

[Setup]
AppId={{6B1E7C3A-4F0D-4E8B-9C2A-3D5F6A7B8C9D}
AppName={#MuName}
AppVersion={#MuVersion}
AppVerName={#MuName} {#MuVersion}
VersionInfoVersion={#MuVersion}
VersionInfoProductName={#MuName}
VersionInfoDescription={#MuName} Setup
AppPublisher=Project Mu
AppPublisherURL=https://github.com/krishivvyas/project-mu
AppSupportURL=https://github.com/krishivvyas/project-mu/issues
AppUpdatesURL=https://github.com/krishivvyas/project-mu/releases/latest
DefaultDirName={autopf}\{#MuName}
DefaultGroupName={#MuName}
; Full step-by-step wizard:
;   Welcome -> License -> Setup type (Standard / Custom) -> [Custom only:
;   Install folder -> Privacy -> Tabs -> Shortcuts & integration] -> Ready ->
;   Installing -> Finish (launch Mu / open Default apps).
DisableWelcomePage=no
DisableReadyPage=no
DisableFinishedPage=no
DisableProgramGroupPage=yes
; Asked on first install only; an update keeps the existing folder.
DisableDirPage=auto
#ifdef MuLicense
LicenseFile={#MuLicense}
#endif
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
UninstallDisplayIcon={app}\{#MuExe}
UninstallDisplayName={#MuName}
WizardStyle=modern dark
SetupIconFile=mu.ico
; Sumi/washi/inkan artwork (installer/make_art.py); Inno picks the size that
; matches the display scaling.
WizardImageFile=wizard-image-100.bmp,wizard-image-150.bmp,wizard-image-200.bmp
WizardSmallImageFile=wizard-small-100.bmp,wizard-small-150.bmp,wizard-small-200.bmp
WizardImageStretch=no
Compression=lzma2/max
SolidCompression=yes
LZMANumBlockThreads=4
; Close a running Mu before replacing its files (Restart Manager).
CloseApplications=force
RestartApplications=no
ChangesAssociations=yes
SetupLogging=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Messages]
WelcomeLabel1=Welcome to Project Mu
WelcomeLabel2=This will install [name/ver] on your computer.%n%nProject Mu is a zero-trace browser built on Chromium. Your session lives while you browse, then returns to nothing when you close the window: history, cookies and cache are cleared on exit.%n%nIt is recommended that you close other applications before continuing.
FinishedHeadingLabel=Project Mu is ready
FinishedLabel=Setup has installed [name] on your computer. Start it from the Start menu or the desktop shortcut.

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop shortcut"; GroupDescription: "Shortcuts:"
Name: "registerbrowser"; Description: "&Register Project Mu as a web browser, so it can be chosen as the default in Windows Settings"; GroupDescription: "Windows integration:"

[InstallDelete]
; Files whose names change between Chromium versions. Everything else is
; overwritten in place. The rest of {app} is never wiped, in case the user
; picked a folder that holds other files.
Type: files; Name: "{app}\*.manifest"
Type: filesandordirs; Name: "{app}\locales"
; Optional extensions: start clean, then [Files] puts back what was chosen on
; the Extensions page (unticking it on a reinstall removes the extension).
Type: filesandordirs; Name: "{app}\mu\ublock"

[Files]
; Generated by build.py: the browser (with Mu's icons in chrome.exe), the
; default initial_preferences and LICENSE-project-mu.txt.
#include MuFiles

[Icons]
Name: "{autoprograms}\{#MuName}"; Filename: "{app}\{#MuExe}"; Parameters: "{#MuLook}"; WorkingDir: "{app}"; AppUserModelID: "{#MuAumid}"
Name: "{autodesktop}\{#MuName}"; Filename: "{app}\{#MuExe}"; Parameters: "{#MuLook}"; WorkingDir: "{app}"; AppUserModelID: "{#MuAumid}"; Tasks: desktopicon

[Registry]
; Browser registration (Default Programs). HKA is HKCU for a per-user install
; and HKLM for an all-users install.
Root: HKA; Subkey: "Software\Classes\{#MuProgId}"; ValueType: string; ValueName: ""; ValueData: "{#MuName} HTML Document"; Flags: uninsdeletekey; Tasks: registerbrowser
Root: HKA; Subkey: "Software\Classes\{#MuProgId}"; ValueType: string; ValueName: "AppUserModelId"; ValueData: "{#MuAumid}"; Tasks: registerbrowser
Root: HKA; Subkey: "Software\Classes\{#MuProgId}\Application"; ValueType: string; ValueName: "ApplicationName"; ValueData: "{#MuName}"; Tasks: registerbrowser
Root: HKA; Subkey: "Software\Classes\{#MuProgId}\Application"; ValueType: string; ValueName: "ApplicationIcon"; ValueData: "{app}\{#MuExe},0"; Tasks: registerbrowser
Root: HKA; Subkey: "Software\Classes\{#MuProgId}\Application"; ValueType: string; ValueName: "AppUserModelId"; ValueData: "{#MuAumid}"; Tasks: registerbrowser
Root: HKA; Subkey: "Software\Classes\{#MuProgId}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MuExe},0"; Tasks: registerbrowser
Root: HKA; Subkey: "Software\Classes\{#MuProgId}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MuExe}"" {#MuLook} --single-argument %1"; Tasks: registerbrowser

Root: HKA; Subkey: "{#MuClientKey}"; ValueType: string; ValueName: ""; ValueData: "{#MuName}"; Flags: uninsdeletekey; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MuExe},0"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MuExe}"" {#MuLook}"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities"; ValueType: string; ValueName: "ApplicationName"; ValueData: "{#MuName}"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities"; ValueType: string; ValueName: "ApplicationIcon"; ValueData: "{app}\{#MuExe},0"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities"; ValueType: string; ValueName: "ApplicationDescription"; ValueData: "A zero-trace Chromium. The session is gone when the window closes."; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities\StartMenu"; ValueType: string; ValueName: "StartMenuInternet"; ValueData: "{#MuName}"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities\URLAssociations"; ValueType: string; ValueName: "http"; ValueData: "{#MuProgId}"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities\URLAssociations"; ValueType: string; ValueName: "https"; ValueData: "{#MuProgId}"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".htm"; ValueData: "{#MuProgId}"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".html"; ValueData: "{#MuProgId}"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".shtml"; ValueData: "{#MuProgId}"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".xht"; ValueData: "{#MuProgId}"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".xhtml"; ValueData: "{#MuProgId}"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".pdf"; ValueData: "{#MuProgId}"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".svg"; ValueData: "{#MuProgId}"; Tasks: registerbrowser
Root: HKA; Subkey: "{#MuClientKey}\Capabilities\FileAssociations"; ValueType: string; ValueName: ".webp"; ValueData: "{#MuProgId}"; Tasks: registerbrowser
Root: HKA; Subkey: "Software\RegisteredApplications"; ValueType: string; ValueName: "{#MuName}"; ValueData: "{#MuClientKey}\Capabilities"; Flags: uninsdeletevalue; Tasks: registerbrowser
; Optional open-with entries, so .html files offer Mu without it being the default.
Root: HKA; Subkey: "Software\Classes\.htm\OpenWithProgids"; ValueType: none; ValueName: "{#MuProgId}"; Flags: uninsdeletevalue; Tasks: registerbrowser
Root: HKA; Subkey: "Software\Classes\.html\OpenWithProgids"; ValueType: none; ValueName: "{#MuProgId}"; Flags: uninsdeletevalue; Tasks: registerbrowser
Root: HKA; Subkey: "Software\Classes\.pdf\OpenWithProgids"; ValueType: none; ValueName: "{#MuProgId}"; Flags: uninsdeletevalue; Tasks: registerbrowser

[Run]
; Chromium runs renderers, the GPU process and the network service in Windows
; AppContainer sandboxes, which can only read the install folder if it grants
; ALL APPLICATION PACKAGES (S-1-15-2-1) and ALL RESTRICTED APPLICATION PACKAGES
; (S-1-15-2-2). Chrome's own installer does the same. Without this, a folder
; outside Program Files breaks the sandbox ("Sandbox cannot access executable")
; and the network service keeps crashing.
Filename: "{sys}\icacls.exe"; Parameters: """{app}"" /grant *S-1-15-2-1:(OI)(CI)(RX) /grant *S-1-15-2-2:(OI)(CI)(RX) /Q"; StatusMsg: "Setting up the browser sandbox..."; Flags: runhidden waituntilterminated
Filename: "{app}\{#MuExe}"; Parameters: "{#MuLook}"; Description: "{cm:LaunchProgram,{#MuName}}"; Flags: nowait postinstall skipifsilent runasoriginaluser
; Windows 10/11 do not let programs make themselves the default browser; this
; opens the Default apps page with Project Mu preselected.
Filename: "{code:DefaultAppsUri}"; Description: "Make Project Mu my default browser (opens Windows Settings)"; Flags: shellexec nowait postinstall skipifsilent unchecked runasoriginaluser; Tasks: registerbrowser

[UninstallDelete]
; Created by the browser next to chrome.exe on some versions.
Type: filesandordirs; Name: "{app}\SetupMetrics"
; Written by the wizard from the privacy choices page.
Type: files; Name: "{app}\initial_preferences"
; Chromium caches the compiled theme inside the theme folder.
Type: files; Name: "{app}\mu\theme\Cached Theme.pak"

[Code]
var
  SetupTypePage: TInputOptionWizardPage;
  PrivacyPage: TInputOptionWizardPage;
  LayoutPage: TInputOptionWizardPage;
  ExtensionsPage: TInputOptionWizardPage;

const
  // Indexes of the checkboxes on PrivacyPage.
  PRIV_CLEAR_COOKIES = 0;
  PRIV_BLOCK_3P = 1;
  PRIV_HTTPS_ONLY = 2;
  PRIV_DNT = 3;
  PRIV_SAVE_HISTORY = 4;
  PRIV_SUGGEST = 5;

function IsCustomSetup: Boolean;
begin
  Result := SetupTypePage.Values[1];
end;

procedure InitializeWizard;
begin
  SetupTypePage := CreateInputOptionPage(wpLicense,
    'Setup type', 'Choose how you want to install Project Mu.',
    'Standard is recommended for most people. Custom lets you choose the install folder, privacy settings and shortcuts.',
    True, False);
  SetupTypePage.Add('&Standard: Mu''s private defaults, Start menu and desktop shortcuts');
  SetupTypePage.Add('&Custom: choose the folder, privacy settings and shortcuts yourself');
  SetupTypePage.Values[0] := True;

  // Shown for Standard and Custom alike: what gets installed into the
  // browser is always the user's choice.
  ExtensionsPage := CreateInputOptionPage(SetupTypePage.ID,
    'Extensions', 'Choose extensions to install with Project Mu.',
    'They are installed inside Mu and update when Mu updates. To remove one later, run this setup again and untick it.',
    False, False);
  ExtensionsPage.Add('uBlock Origin Lite: blocks ads, trackers and malware sites (recommended). ' +
    'Free and open source (GPLv3), by Raymond Hill: github.com/uBlockOrigin/uBOL-home');
  ExtensionsPage.Values[0] := True;

  PrivacyPage := CreateInputOptionPage(wpSelectDir,
    'Privacy', 'Choose how private Project Mu should be.',
    'These are Mu''s defaults; you can change every one later under Settings > Privacy and security. ' +
    'They apply to a new profile; an existing profile keeps its settings.',
    False, False);
  PrivacyPage.Add('Delete cookies and site data when Mu closes');
  PrivacyPage.Add('Block third-party cookies');
  PrivacyPage.Add('Always use secure connections (warn before loading HTTP sites)');
  PrivacyPage.Add('Send a "Do Not Track" request with browsing traffic');
  PrivacyPage.Add('Save browsing history (it is still cleared when Mu closes)');
  PrivacyPage.Add('Show search suggestions while typing (sends keystrokes to the search engine)');
  PrivacyPage.Values[PRIV_CLEAR_COOKIES] := True;
  PrivacyPage.Values[PRIV_BLOCK_3P] := True;
  PrivacyPage.Values[PRIV_HTTPS_ONLY] := True;
  PrivacyPage.Values[PRIV_DNT] := True;
  PrivacyPage.Values[PRIV_SAVE_HISTORY] := False;
  PrivacyPage.Values[PRIV_SUGGEST] := False;

  LayoutPage := CreateInputOptionPage(PrivacyPage.ID,
    'Tabs', 'Choose where your tabs live.',
    'You can switch at any time: right-click a tab and choose the other layout.',
    True, False);
  LayoutPage.Add('Side rail: tabs in a slim column on the left that opens when you hover (recommended)');
  LayoutPage.Add('Classic: tabs along the top');
  LayoutPage.Values[0] := True;
end;

function WantUBlock: Boolean;
begin
  Result := ExtensionsPage.Values[0];
end;

function VerticalTabs: Boolean;
begin
  Result := LayoutPage.Values[0];
end;

function LayoutName: String;
begin
  if VerticalTabs then Result := 'Side rail' else Result := 'Classic (top)';
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  // Standard setup goes straight from Setup type to Ready.
  Result := (not IsCustomSetup) and
            ((PageID = wpSelectDir) or (PageID = PrivacyPage.ID) or
             (PageID = LayoutPage.ID) or (PageID = wpSelectTasks));
end;

function YesNo(Value: Boolean): String;
begin
  if Value then Result := 'on' else Result := 'off';
end;

function UpdateReadyMemo(Space, NewLine, MemoUserInfoInfo, MemoDirInfo, MemoTypeInfo,
  MemoComponentsInfo, MemoGroupInfo, MemoTasksInfo: String): String;
begin
  if IsCustomSetup then
    Result := 'Setup type:' + NewLine + Space + 'Custom'
  else
    Result := 'Setup type:' + NewLine + Space + 'Standard';
  Result := Result + NewLine + NewLine + MemoDirInfo + NewLine + NewLine +
    'Tabs:' + NewLine + Space + LayoutName + NewLine + NewLine +
    'Extensions:' + NewLine + Space + 'uBlock Origin Lite: ' + YesNo(WantUBlock) + NewLine + NewLine +
    'Privacy:' + NewLine +
    Space + 'Delete cookies on close: ' + YesNo(PrivacyPage.Values[PRIV_CLEAR_COOKIES]) + NewLine +
    Space + 'Block third-party cookies: ' + YesNo(PrivacyPage.Values[PRIV_BLOCK_3P]) + NewLine +
    Space + 'Always use secure connections: ' + YesNo(PrivacyPage.Values[PRIV_HTTPS_ONLY]) + NewLine +
    Space + 'Do Not Track: ' + YesNo(PrivacyPage.Values[PRIV_DNT]) + NewLine +
    Space + 'Save browsing history: ' + YesNo(PrivacyPage.Values[PRIV_SAVE_HISTORY]) + NewLine +
    Space + 'Search suggestions: ' + YesNo(PrivacyPage.Values[PRIV_SUGGEST]);
  if MemoTasksInfo <> '' then
    Result := Result + NewLine + NewLine + MemoTasksInfo;
end;

function JsonBool(Value: Boolean): String;
begin
  if Value then Result := 'true' else Result := 'false';
end;

// Chromium copies initial_preferences (next to chrome.exe) into a new
// profile on its first run, so the choices above become that profile's
// settings. Keys are the browser's own preference names.
procedure WriteInitialPreferences;
var
  Cookies, ControlsMode, Json: String;
begin
  if PrivacyPage.Values[PRIV_CLEAR_COOKIES] then Cookies := '4' else Cookies := '1';      // session only / allow
  if PrivacyPage.Values[PRIV_BLOCK_3P] then ControlsMode := '1' else ControlsMode := '2'; // block 3P / Incognito only
  Json :=
    '{' + #13#10 +
    '  "distribution": {' + #13#10 +
    '    "skip_first_run_ui": true,' + #13#10 +
    '    "import_bookmarks": false,' + #13#10 +
    '    "import_history": false,' + #13#10 +
    '    "import_search_engine": false,' + #13#10 +
    '    "make_chrome_default_for_user": false,' + #13#10 +
    '    "suppress_first_run_default_browser_prompt": true' + #13#10 +
    '  },' + #13#10 +
    '  "browser": {' + #13#10 +
    '    "check_default_browser": false,' + #13#10 +
    '    "theme": { "color_scheme2": 2, "is_grayscale2": true }' + #13#10 +
    '  },' + #13#10 +
    '  "profile": {' + #13#10 +
    '    "cookie_controls_mode": ' + ControlsMode + ',' + #13#10 +
    '    "default_content_setting_values": { "cookies": ' + Cookies + ' }' + #13#10 +
    '  },' + #13#10 +
    '  "https_only_mode_enabled": ' + JsonBool(PrivacyPage.Values[PRIV_HTTPS_ONLY]) + ',' + #13#10 +
    '  "enable_do_not_track": ' + JsonBool(PrivacyPage.Values[PRIV_DNT]) + ',' + #13#10 +
    '  "history": { "saving_disabled": ' + JsonBool(not PrivacyPage.Values[PRIV_SAVE_HISTORY]) + ' },' + #13#10 +
    '  "search": { "suggest_enabled": ' + JsonBool(PrivacyPage.Values[PRIV_SUGGEST]) + ' },' + #13#10 +
    '  "vertical_tabs": { "enabled": ' + JsonBool(VerticalTabs) +
    ', "collapsed_state": true, "expand_on_hover": true },' + #13#10 +
    // The "Tab groups" button at the top of the rail starts unpinned; it can
    // be pinned again from the tab strip's context menu.
    '  "everything_menu": { "pinned_to_tabstrip": false }' + #13#10 +
    '}' + #13#10;
  if not SaveStringToFile(ExpandConstant('{app}\initial_preferences'), Json, False) then
    Log('could not write initial_preferences');
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
    WriteInitialPreferences;
end;

function DefaultAppsUri(Param: String): String;
begin
  if IsAdminInstallMode then
    Result := 'ms-settings:defaultapps?registeredAppMachine={#MuName}'
  else
    Result := 'ms-settings:defaultapps?registeredAppUser={#MuName}';
  StringChangeEx(Result, ' ', '%20', True);
end;

// After removing the program, offer to remove the profile too. Mu deletes
// history, cookies and cache on exit, but saved passwords, autofill entries
// and site permissions are kept on purpose; this is the way to drop those.
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Profile: String;
begin
  if CurUninstallStep <> usPostUninstall then
    exit;
  Profile := ExpandConstant('{localappdata}\{#MuName}');
  if not DirExists(Profile) then
    exit;
  if UninstallSilent then
    exit;
  if MsgBox('Also delete your Project Mu profile?' + #13#10 + #13#10 +
            'This removes saved passwords, autofill entries, bookmarks and site ' +
            'settings in:' + #13#10 + Profile, mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES then
    DelTree(Profile, True, True, True);
end;
